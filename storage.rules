rules_version = '2';

// Fotos das ocorrências. Testes: regras/__tests__/storage.test.ts (npm run test:regras).
service firebase.storage {
  match /b/{bucket}/o {
    match /fotos/{uid}/{arquivo} {
      allow read: if request.auth != null;
      // Só JPEG (o app recomprime e remove os metadados antes), até 5 MB, na própria pasta e sem sobrescrever.
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == uid
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= 5 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
