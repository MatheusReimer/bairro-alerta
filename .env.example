# Copie para .env (que não vai para o git).
# Desenvolvimento e testes: Firebase Emulator Suite, sem dados reais.
EXPO_PUBLIC_USE_EMULATORS=1
# Celular real na mesma rede: IP do computador que roda `npm run emuladores`.
# EXPO_PUBLIC_EMULATOR_HOST=192.168.0.10

# Piloto: projeto real do Firebase (Console > Configurações do projeto > Seus apps > Web).
# EXPO_PUBLIC_USE_EMULATORS=0
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
